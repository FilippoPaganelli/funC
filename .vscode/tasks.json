{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "build-c",
            "command": "/usr/bin/gcc",
            "args": [
                "-fdiagnostics-color=always",
                // "-Wall",
                // "-Wextra",
                "-g3",
                "-O0",
                "${workspaceFolder}/main.c",
                "-o",
                "${workspaceFolder}/main",
                "-lz"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build main.c with debug symbols (used by the debugger)"
        },
        {
            "type": "cppbuild",
            "label": "build-c-asan",
            "command": "/usr/bin/gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-Wall",
                "-Wextra",
                "-g3",
                "-O0",
                "-fsanitize=address,undefined",
                "-fno-omit-frame-pointer",
                "${workspaceFolder}/main.c",
                "-o",
                "${workspaceFolder}/main-asan"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Build main.c with AddressSanitizer + UBSan"
        }
    ]
}
